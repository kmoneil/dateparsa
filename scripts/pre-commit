#!/bin/sh
# Pre-commit hook: fast checks before every commit.
# Install: make hooks

set -e

echo "pre-commit: running go vet..."
go vet ./...

echo "pre-commit: running tests..."
go test -count=1 -timeout=60s ./...

echo "pre-commit: verifying zero-alloc Layout.Parse..."
go test -run=TestLayoutParseZeroAlloc -count=1 -timeout=15s

echo "pre-commit: all checks passed."
