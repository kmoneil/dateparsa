#!/bin/sh
# Check the commit header is a Conventional Commit.
#
# The shape only: a header that parses says nothing about whether the body
# explains anything, and the body is the part that matters. This catches the
# mechanical mistake, not the substantive one.
set -e

# The subject is what git will record, which is not the first line of this file.
# git takes everything up to the first blank line and joins it with spaces, so a
# wrapped subject is one long subject to every reader there will ever be. This
# read `head -1`, so a subject wrapped at 72 by an editor passed the 72 check and
# was recorded at 78.
#
# Comment lines are skipped because git strips them before recording and this
# hook runs before that happens. Reading line 1 also meant that a message written
# in an editor, whose first line is git's own "# Please enter..." comment, was
# checked for Conventional Commit shape against the comment and refused.
subject_of() {
	awk '
		/^#/ { next }
		/^[[:space:]]*$/ { if (started) exit; next }
		{ started = 1; print }
	' "$1"
}

# Everything after the blank line that ends the subject. Comment lines are left
# in, which is why the heading rule below matches two hashes and not one.
body_of() {
	awk '
		st == 0 { if ($0 ~ /^#/ || $0 ~ /^[[:space:]]*$/) next; st = 1; next }
		st == 1 { if ($0 ~ /^[[:space:]]*$/) st = 2; next }
		{ print }
	' "$1"
}

lines=$(subject_of "$1")
header=$(printf '%s' "$lines" | tr '\n' ' ' | sed 's/[[:space:]]*$//')

# A merge, revert, or fixup carries its own conventions.
case "$header" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|test|refactor|perf|chore|build|ci)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s' "$header" | grep -Eq "$pattern"; then
	echo "commit-msg: the header is not a Conventional Commit."
	echo
	echo "  got:  $header"
	echo "  want: <type>(<scope>): <subject>"
	echo
	echo "  types:  feat fix docs test refactor perf chore build ci"
	echo "  scopes: detect compile natural locale epoch flextime api bench ci readme"
	echo "  e.g.:   feat(detect): add ISO 8601 duration signatures"
	echo "          perf(natural): fold accents without allocating"
	exit 1
fi

subject=${header#*: }

# A subject git will record as one line, written here as two. The length check
# below cannot catch this: each line is short and their join is not. Two short
# lines where the author meant the second to be the body land here too, which is
# the case length could never have caught.
if [ "$(printf '%s' "$lines" | wc -l)" -gt 0 ]; then
	echo "commit-msg: the subject is wrapped across $(($(printf '%s' "$lines" | wc -l) + 1)) lines."
	echo
	printf '%s\n' "$lines" | sed 's/^/  /'
	echo
	echo "  git joins those with spaces and records one subject, ${#header} characters:"
	echo
	echo "  $header"
	echo
	echo "  Put a blank line before the body, or shorten the subject."
	exit 1
fi

# The length is measured on what the author wrote, which is not always what git
# ends up recording. GitHub appends " (#123)" to the header when a pull request
# is squashed, five or six characters this hook never sees and the author cannot
# prevent, and that is how a 69-character subject entered this history at 75.
#
# Discounting the suffix rather than tightening the limit is the choice. The
# limit that would survive a squash is 66, and the last fifty subjects here
# include eleven between 67 and 72, so tightening would refuse the project's own
# history, and a gate that refuses the history is a gate somebody turns off.
#
# It still shows in `git log --oneline` at its full width, so a subject near the
# limit is one that reads long after the merge. That is a reason to write short
# subjects, not a reason to refuse this one.
measured=$(printf '%s' "$header" | sed 's/ (#[0-9][0-9]*)$//')

if [ ${#measured} -gt 72 ]; then
	echo "commit-msg: the header is ${#measured} characters; keep it under 72."
	echo "  $measured"
	exit 1
fi
case "$subject" in
*.)
	echo "commit-msg: the subject ends with a period; drop it."
	exit 1
	;;
esac

# No markdown in the body.
#
# A commit message is plain text. Git renders nothing, and GitHub shows it
# preformatted, so a heading is the characters "## " and a table is a row of
# pipes on every surface that will ever display it.
#
# What stays: hyphen bullets, indented blocks for code and benchmark output,
# backticks around identifiers, bare URLs, and trailers. The test is whether it
# reads correctly unrendered, which is the only way it will ever be read.
#
# Headings are matched from two hashes rather than one. This file still holds
# git's own comment lines when a message is written in an editor, and those
# start with a single hash, so "# " cannot be told apart from an H1 here.
body=$(body_of "$1")

# A machine wrote this body and no human can rewrite it. Dependabot's message is
# markdown by construction, it reaches main through GitHub rather than through
# this hook, and so the rules below can never actually be enforced against it.
# Applying them anyway has exactly one effect: this repository's own history
# fails its own gate, and a gate that refuses the history is a gate somebody
# switches off. The header rules above still apply, and Dependabot's header
# passes them, which is the part a bot can get wrong.
if printf '%s\n' "$body" | grep -q '^Signed-off-by: dependabot\[bot\]'; then
	exit 0
fi

flag() {
	echo "commit-msg: $1 in the body, and a commit message is plain text."
	echo
	printf '%s\n' "$body" | grep -nE "$2" | head -3 | sed 's/^/  /'
	echo
	echo "  $3"
	echo
	echo "  Keep: hyphen bullets, indented code and benchmark output, backticks,"
	echo "  bare URLs, trailers. It has to read correctly unrendered."
	exit 1
}

printf '%s\n' "$body" | grep -Eq '^#{2,6} ' &&
	flag "a markdown heading" '^#{2,6} ' "Say it in a sentence, or start a new paragraph."
printf '%s\n' "$body" | grep -Eq '^\|' &&
	flag "a markdown table" '^\|' "Use an indented block, or prose. Benchstat output is already indented."
printf '%s\n' "$body" | grep -Eq '^[-*] \[[ xX]\]' &&
	flag "a task list" '^[-*] \[[ xX]\]' "Checklists belong on the pull request, not in the history."
printf '%s\n' "$body" | grep -Eq '^```' &&
	flag "a fenced code block" '^```' "Indent the block by four spaces instead."
printf '%s\n' "$body" | grep -Eq '\*\*[^*/ ][^*/]*\*\*' &&
	flag "markdown emphasis" '\*\*[^*/ ][^*/]*\*\*' "Emphasis does not survive plain text; write the sentence so it does not need it."
printf '%s\n' "$body" | grep -Eq '\[[^]]+\]\([^)]+\)' &&
	flag "a markdown link" '\[[^]]+\]\([^)]+\)' "Put the bare URL, which a terminal can follow."

exit 0
